# Example environment variables for tunAide AP frontend
# Do NOT put server secrets here. Only public configuration.

# The public URL of the tunAide AP FastAPI backend
EXPO_PUBLIC_API_URL=http://192.168.x.x:8000

# The URL of the TunAIde Phase One web application (optional, for "View on Website" links)
EXPO_PUBLIC_TRANSCRIBE_WEB_URL=https://tunaide-production-799d.up.railway.app
